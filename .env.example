# Copie para .env e preencha. Nunca commite o .env.
#
# SECRET_KEY é obrigatória: no mínimo 32 caracteres, gerada aleatoriamente.
# A aplicação recusa iniciar com chave ausente, curta, de exemplo ou já
# publicada. Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=480

# Cookies de sessão com o atributo Secure. Mantenha true (navegadores
# aceitam Secure em http://localhost). Use false apenas para testar por
# HTTP em outro endereço.
COOKIE_SECURE=true

# Quantidade de proxies reversos confiáveis na frente da aplicação.
# 0 = ignora X-Forwarded-For. No Render, use 1.
TRUSTED_PROXY_HOPS=0

# Ligue somente quando o serviço estiver publicado em HTTPS.
HSTS_ENABLED=false
